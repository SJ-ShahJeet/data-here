# Copy to .env and fill in. .env is gitignored.

# --- Bright Data (https://brightdata.com/cp) ---
BRIGHTDATA_API_KEY=
# Web Unlocker zone name (fetches company websites)
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
# SERP API zone name (finds company domains + LinkedIn URLs)
BRIGHTDATA_SERP_ZONE=serp_api1
# Web Scraper API dataset ids (verify in the dashboard: Web Scrapers > LinkedIn)
BRIGHTDATA_LINKEDIN_PROFILES_DATASET=gd_l1viktl72bvl7bjuj0
BRIGHTDATA_LINKEDIN_POSTS_DATASET=gd_lyy3tktm25m4avu764
BRIGHTDATA_LINKEDIN_COMPANY_DATASET=gd_l1vikfnt1wgvvqz95w

# --- OpenAI via TrueFoundry AI Gateway ---
# Point OPENAI_BASE_URL at the TrueFoundry gateway to route + log every call there.
# Leave blank to call OpenAI directly.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

# --- TrueFoundry (agent + MCP registration) ---
TRUEFOUNDRY_API_KEY=
TRUEFOUNDRY_HOST=

# --- FalkorDB (docker compose up -d) ---
FALKORDB_URL=redis://localhost:6379
GRAPH_NAME=datahere

# --- Email (sent only after human approval) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=

# --- Runtime ---
# 1 = never hit the network; serve only from cache/ (story mode)
OFFLINE=0
CACHE_DIR=cache
