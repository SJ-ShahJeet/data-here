{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.memory-graph/adapters/claude/session-start.sh\"",
            "timeout": 10,
            "statusMessage": "memory-graph: loading project memory"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Grep|Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.memory-graph/adapters/claude/tool-output.sh\"",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.memory-graph/adapters/claude/track-file.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.memory-graph/adapters/claude/session-end.sh\"",
            "timeout": 60,
            "statusMessage": "memory-graph: saving session"
          }
        ]
      }
    ]
  }
}
